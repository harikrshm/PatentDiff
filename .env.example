# PatentDiff Environment Variables

# Groq API key (required for live mode, not needed in demo mode)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Optional: LLM model to use (default: openai/gpt-oss-120b)
# PATENTDIFF_MODEL=openai/gpt-oss-120b

# DEMO MODE: Set to 'true' to run in cache-first mode
# - Pre-loads all cached traces/evals on startup
# - Disables live Groq API calls
# - Enables fast cold starts (1-2 sec)
# - No API key required
# - Dashboard, Traces, Comparison tabs are fully interactive
DEMO_MODE=false
